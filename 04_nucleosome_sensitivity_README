## Step 7 — Upset plots for cross-condition comparisons (R)

Reproducible nucleosome changes were compared across conditions using UpSet plots. Gene-name-annotated files from Step 5 were used as input.

```r
library(dplyr)
library(tidyr)
library(UpSetR)
library(tibble)

setwd("/home/jbenoit/DANPOS3/")

# Read gene-name-annotated repositioning files (one per replicate/condition)
file_rep1 <- read.delim("TSS_sample1_repositioning.bed", header = FALSE)
file_rep2 <- read.delim("TSS_sample2_repositioning.bed", header = FALSE)

# Combine gene name columns (V7) across files, padding shorter ones with NA
data_frames <- list(file_rep1, file_rep2)
max_rows <- max(sapply(data_frames, nrow))

combined_df <- bind_cols(
    lapply(data_frames, function(df) {
        c(df$V7, rep(NA, max_rows - nrow(df)))
    })
)
colnames(combined_df) <- paste0("V7_", c("sample1", "sample2"))

# Convert to long format and build binary presence matrix
gene_long <- combined_df %>%
    rownames_to_column(var = "ID") %>%
    pivot_longer(cols = -ID, names_to = "condition", values_to = "gene") %>%
    filter(!is.na(gene) & gene != "")

gene_binary <- gene_long %>%
    distinct(gene, condition) %>%
    mutate(Presence = 1) %>%
    pivot_wider(names_from = condition,
                values_from = Presence,
                values_fill = 0)

gene_binary_df <- as.data.frame(
    gene_binary %>% select(-gene) %>% mutate(across(everything(), as.numeric))
)
colnames(gene_binary_df) <- sub("^V7_", "", colnames(gene_binary_df))

# UpSet plot
upset(
    gene_binary_df,
    sets       = colnames(gene_binary_df),
    order.by   = "freq",
    keep.order = TRUE,
    nsets      = 10,
    text.scale = 2,
    main.bar.color = "steelblue",
    sets.bar.color = "skyblue"
)
```

